{
  "scripts": {
    "build": "npm run tailwind && npm run 11ty",
    "dev": "concurrently \"npm run 11ty:serve\" \"npm run tailwind:watch\"",
    "11ty": "npx @11ty/eleventy",
    "11ty:serve": "npx @11ty/eleventy --serve",
    "tailwind": "npx @tailwindcss/cli -i ./bundle.css -o ./src/bundle.css",
    "tailwind:watch": "npx @tailwindcss/cli -i ./bundle.css -o ./src/bundle.css --watch"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@tailwindcss/cli": "^4.0.14",
    "tailwindcss": "^4.0.14"
  },
  "devDependencies": {
    "chokidar": "^3.6.0",
    "concurrently": "^9.1.2"
  },
  "type": "commonjs"
}
